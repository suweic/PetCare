# =============================================================================
# PetCare 宠物在线问诊系统 — 环境变量配置模板
# =============================================================================
# 使用方式：
#   cp .env.example .env
#   ⚠️ 编辑 .env 填入真实值（尤其是 JWT_SECRET, AES_KEY, DB_PASSWORD）
#   docker compose up -d
# =============================================================================

# ----- 数据库 -----
DB_ROOT_PASSWORD=change-me-to-a-strong-root-password
DB_NAME=petcare
DB_USERNAME=petcare
DB_PASSWORD=change-me-to-a-strong-password

# ----- Redis -----
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# ----- JWT -----
# 至少 32 字符 Base64，生成方式: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-base64-string-at-least-32-chars

# ----- AES 加密 -----
# 32 字节 Base64，生成方式: openssl rand -base64 32
# 用于身份证号等敏感个人信息加密存储（个人信息保护法合规要求）
AES_KEY=change-me-to-a-random-base64-string-at-least-32-chars

# ----- Spring Profiles -----
SPRING_PROFILES_ACTIVE=prod

# ----- LLM API（AI预问诊模块） -----
# OpenAI兼容接口，支持 OpenAI / Azure OpenAI / 国产大模型等
# 示例: https://api.openai.com/v1/chat/completions
LLM_API_URL=
# LLM API密钥
LLM_API_KEY=
# 模型名称（默认 gpt-4o-mini，可根据接入的API选择）
LLM_MODEL=gpt-4o-mini

# ----- 服务端口映射 -----
MYSQL_PORT=3306
REDIS_PORT=6379
SERVER_PORT=8080
ADMIN_PORT=8081
WEB_PORT=8082
